{
  "name": "dev-themes",
  "displayName": "Dev Themes (Light & Dark)",
  "description": "High-density light and dark themes with PHP-tuned syntax colours, file icons and product icons, inspired by modern IDE layouts.",
  "version": "0.3.0",
  "publisher": "mreromz",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "light",
    "dark",
    "php",
    "laravel",
    "icons",
    "file icons",
    "product icons",
    "color-theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Dev Light",
        "uiTheme": "vs",
        "path": "./themes/intellij-light-ide-color-theme.json"
      },
      {
        "label": "Dev Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/intellij-dark-ide-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "intellij-light-file-icons",
        "label": "Dev File Icons",
        "path": "./icons/intellij-light-file-icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "intellij-light-product-icons",
        "label": "Dev Product Icons",
        "path": "./icons/intellij-product-icons.json"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/moswco-org/intellij-vscode-theme.git"
  },
  "bugs": {
    "url": "https://github.com/moswco-org/intellij-vscode-theme/issues"
  },
  "homepage": "https://github.com/moswco-org/intellij-vscode-theme#readme",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#F7F8FA",
    "theme": "light"
  }
}
