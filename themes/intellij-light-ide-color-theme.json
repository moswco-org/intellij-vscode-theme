    "editorLineNumber.foreground": "#a4a8b2",
    "editorLineNumber.activeForeground": "#1d1f23",
    "editorGutter.foldingControlForeground": "#a4a8b2",
    "editorGutter.modifiedBackground": "#a8c2f7",
    "editorGutter.addedBackground": "#b4dcbd",
    "editorGutter.deletedBackground": "#c9ccd6",
    "editorGutter.commentRangeForeground": "#c9ccd6",

    // Inlay hints / lightbulb ("Promote property candidate")
    "editorInlayHint.background": "#ebecf0",
    "editorInlayHint.foreground": "#6c707e",
    "editorInlayHint.parameterBackground": "#ebecf0",
    "editorInlayHint.parameterForeground": "#6c707e",
    "editorInlayHint.typeBackground": "#ebecf0",
    "editorInlayHint.typeForeground": "#6c707e",
    "editorLightBulb.foreground": "#e8a33d",
