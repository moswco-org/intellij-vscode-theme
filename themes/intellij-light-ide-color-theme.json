// IntelliJ Light IDE — colour theme for VS Code
// Layout mirrors the PhpStorm New UI (light):
//   ┌ title bar + search-everywhere ─────────────────────────────────────┐
//   │ tool strip │ project tree │ tabs · breadcrumbs · editor · hovers    │
//   │            │              ├─ run / terminal / services panel ───────┤
//   └ status bar ─────────────────────────────────────────────────────────┘
// Palette
//   text #1d1f23 · secondary #6c707e · muted #a4a8b2 · border #dfe1e5
//   chrome #f6f8fa · strip #f2f4f5 · editor #ffffff · accent #3574f0
//   green #208a3c · red #e53935 · orange #e67e22
{
  "$schema": "vscode://schemas/color-theme",
  "name": "IntelliJ Light IDE",
  "type": "light",
  "semanticHighlighting": true,
  "colors": {
    // ── 1. Base ──────────────────────────────────────────────────────────────
    "focusBorder": "#3574f0",
    "foreground": "#1d1f23",
    "disabledForeground": "#a4a8b2",
    "descriptionForeground": "#6c707e",
    "errorForeground": "#e53935",
    "icon.foreground": "#6c707e",
    "selection.background": "#3574f040",
    "widget.shadow": "#0000001a",
    "widget.border": "#dfe1e5",
    "contrastBorder": "#00000000",
    "sash.hoverBorder": "#3574f0",
    "progressBar.background": "#3574f0",
    "badge.background": "#3574f0",
    "badge.foreground": "#ffffff",
    "textLink.foreground": "#3574f0",
    "textLink.activeForeground": "#2862d8",
    "textCodeBlock.background": "#f0f2f5",
    "textBlockQuote.background": "#f6f8fa",
    "textBlockQuote.border": "#c9ccd6",
    "textPreformat.foreground": "#1d1f23",
    "textPreformat.background": "#ebecf0",
    "textSeparator.foreground": "#dfe1e5",

    // ── 2. Window / title bar (top bar with project + branch widgets) ──────
    "window.activeBorder": "#dfe1e5",
    "window.inactiveBorder": "#dfe1e5",
    "titleBar.activeBackground": "#eef1f4",
    "titleBar.activeForeground": "#1d1f23",
    "titleBar.inactiveBackground": "#f6f8fa",
    "titleBar.inactiveForeground": "#6c707e",
    "titleBar.border": "#dfe1e5",
    "menubar.selectionBackground": "#dfe3ea",
    "menubar.selectionForeground": "#1d1f23",
    // "Search Everywhere" field in the screenshot
    "commandCenter.background": "#ffffff",
    "commandCenter.foreground": "#6c707e",
    "commandCenter.border": "#d3d5db",
    "commandCenter.hoverBackground": "#f6f8fa",
    "commandCenter.activeBackground": "#ffffff",
    "commandCenter.activeForeground": "#1d1f23",
    "commandCenter.activeBorder": "#3574f0",
    "commandCenter.inactiveForeground": "#a4a8b2",
    "commandCenter.inactiveBorder": "#dfe1e5",
    "keybindingLabel.background": "#ebecf0",
    "keybindingLabel.foreground": "#6c707e",
    "keybindingLabel.border": "#d3d5db",
    "keybindingLabel.bottomBorder": "#c9ccd6",

    // ── 3. Tool-window strip (activity bar) ─────────────────────────────────
    "activityBar.background": "#f6f8fa",
    "activityBar.foreground": "#1d1f23",
    "activityBar.inactiveForeground": "#6c707e",
    "activityBar.border": "#dfe1e5",
    "activityBar.activeBorder": "#00000000",
    "activityBar.activeBackground": "#dfe3ea",
    "activityBar.activeFocusBorder": "#3574f0",
    "activityBar.dropBorder": "#3574f0",
    "activityBarBadge.background": "#3574f0",
    "activityBarBadge.foreground": "#ffffff",
    "activityBarTop.foreground": "#1d1f23",
    "activityBarTop.inactiveForeground": "#6c707e",
    "activityBarTop.activeBorder": "#3574f0",

    // ── 4. Project tool window (side bar) ──────────────────────────────────
