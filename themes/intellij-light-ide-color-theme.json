    "minimap.findMatchHighlight": "#ffd34d",
    "minimapSlider.background": "#8c8c8c1a",
    "minimapSlider.hoverBackground": "#8c8c8c33",
    "minimapSlider.activeBackground": "#8c8c8c4d",

