    "editorActionList.foreground": "#8e44c9",
    "editorActionList.focusBackground": "#d5e1ff",
    "editorActionList.focusForeground": "#1d1f23",
    "editorMarkerNavigation.background": "#ffffff",
    "editorMarkerNavigationError.background": "#e53935",
    "editorMarkerNavigationWarning.background": "#e8a33d",
    "editorMarkerNavigationInfo.background": "#3574f0",
    "peekView.border": "#3574f0",
    "peekViewTitle.background": "#f6f8fa",
    "peekViewTitleLabel.foreground": "#1d1f23",
    "peekViewTitleDescription.foreground": "#6c707e",
    "peekViewEditor.background": "#fbfcfd",
    "peekViewEditorGutter.background": "#fbfcfd",
    "peekViewEditor.matchHighlightBackground": "#ffeb9c",
    "peekViewResult.background": "#f6f8fa",
    "peekViewResult.selectionBackground": "#d5e1ff",
    "peekViewResult.selectionForeground": "#1d1f23",
    "peekViewResult.matchHighlightBackground": "#ffeb9c",

