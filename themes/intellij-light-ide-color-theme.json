    "sideBar.foreground": "#1d1f23",
    "sideBar.border": "#dfe1e5",
    "sideBar.dropBackground": "#3574f01a",
    "sideBarTitle.foreground": "#1d1f23",
    "sideBarSectionHeader.background": "#f6f8fa",
    "sideBarSectionHeader.foreground": "#1d1f23",
    "sideBarSectionHeader.border": "#00000000",
    "sideBarStickyScroll.background": "#f6f8fa",
    "sideBarStickyScroll.shadow": "#0000000f",

    // Lists & trees — selected file reads as a white row on the grey panel
    "list.activeSelectionBackground": "#ffffff",
    "list.activeSelectionForeground": "#1d1f23",
    "list.activeSelectionIconForeground": "#1d1f23",
    "list.inactiveSelectionBackground": "#e4e6eb",
    "list.inactiveSelectionForeground": "#1d1f23",
    "list.hoverBackground": "#eceef2",
    "list.hoverForeground": "#1d1f23",
    "list.focusBackground": "#ffffff",
    "list.focusForeground": "#1d1f23",
    "list.focusOutline": "#3574f0",
    "list.focusAndSelectionOutline": "#3574f0",
    "list.inactiveFocusOutline": "#00000000",
    "list.highlightForeground": "#3574f0",
    "list.focusHighlightForeground": "#3574f0",
    "list.errorForeground": "#e53935",
    "list.warningForeground": "#c27d04",
    "list.deemphasizedForeground": "#a4a8b2",
    "list.dropBackground": "#3574f01a",
    "list.filterMatchBackground": "#ffeb9c80",
    "listFilterWidget.background": "#ffffff",
    "listFilterWidget.outline": "#3574f0",
    "listFilterWidget.noMatchesOutline": "#e53935",
    "tree.indentGuidesStroke": "#dfe1e5",
    "tree.inactiveIndentGuidesStroke": "#ebecf0",

    // ── 5. Editor tabs ─────────────────────────────────────────────────────
    "editorGroup.border": "#dfe1e5",
    "editorGroup.dropBackground": "#3574f01a",
    "editorGroupHeader.tabsBackground": "#f2f4f5",
    "editorGroupHeader.tabsBorder": "#dfe1e5",
    "editorGroupHeader.noTabsBackground": "#ffffff",
    "editorGroupHeader.border": "#dfe1e5",
    "tab.activeBackground": "#ffffff",
    "tab.activeForeground": "#1d1f23",
    "tab.activeBorder": "#3574f0",
    "tab.activeBorderTop": "#00000000",
    "tab.inactiveBackground": "#f2f4f5",
    "tab.inactiveForeground": "#474a54",
    "tab.hoverBackground": "#ebedf0",
    "tab.hoverForeground": "#1d1f23",
    "tab.border": "#dfe1e5",
    "tab.unfocusedActiveBackground": "#ffffff",
    "tab.unfocusedActiveForeground": "#474a54",
    "tab.unfocusedActiveBorder": "#a4a8b2",
    "tab.unfocusedInactiveBackground": "#f2f4f5",
    "tab.unfocusedInactiveForeground": "#6c707e",
    "tab.activeModifiedBorder": "#3574f0",
    "tab.inactiveModifiedBorder": "#3574f0",
    "tab.lastPinnedBorder": "#c9ccd6",
    "tab.dragAndDropBorder": "#3574f0",

    // ── 6. Breadcrumbs (laravel-api › app › Http › … › checkout()) ────────
    "breadcrumb.background": "#f6f8fa",
    "breadcrumb.foreground": "#6c707e",
    "breadcrumb.focusForeground": "#1d1f23",
    "breadcrumb.activeSelectionForeground": "#3574f0",
    "breadcrumbPicker.background": "#ffffff",

    // ── 7. Editor ──────────────────────────────────────────────────────────
    "editor.background": "#ffffff",
    "editor.foreground": "#1d1f23",
    "editorCursor.foreground": "#1d1f23",
    "editor.lineHighlightBackground": "#f2f6fe",
    "editor.lineHighlightBorder": "#00000000",
    "editor.selectionBackground": "#a6d2ff",
    "editor.inactiveSelectionBackground": "#a6d2ff80",
    "editor.selectionHighlightBackground": "#dfe9fc",
    "editor.wordHighlightBackground": "#e8edf5",
    "editor.wordHighlightStrongBackground": "#f6e3fa",
    "editor.findMatchBackground": "#ffd34d",
    "editor.findMatchHighlightBackground": "#ffeb9c99",
    "editor.findRangeHighlightBackground": "#f2f6fe",
    "editor.hoverHighlightBackground": "#e8edf5",
    "editor.rangeHighlightBackground": "#f2f6fe",
    "editor.linkedEditingBackground": "#dfe9fc",
    "editorLink.activeForeground": "#3574f0",
    "editorWhitespace.foreground": "#d3d5db",
    "editorIndentGuide.background1": "#ebecf0",
    "editorIndentGuide.activeBackground1": "#c9ccd6",
    "editorRuler.foreground": "#ebecf0",
    "editorCodeLens.foreground": "#8c8c8c",
    "editorBracketMatch.background": "#dfe9fc",
    "editorBracketMatch.border": "#00000000",
    "editorBracketHighlight.foreground1": "#1d1f23",
    "editorBracketHighlight.foreground2": "#1d1f23",
