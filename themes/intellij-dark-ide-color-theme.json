    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7a7e85", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment",
      "scope": ["comment.block.documentation", "comment.block.documentation punctuation.definition.comment"],
      "settings": { "foreground": "#5f826b", "fontStyle": "italic" }
    },
    {
      "name": "Doc tag (@param, @throws…)",
      "scope": ["keyword.other.phpdoc", "storage.type.class.jsdoc", "entity.name.tag.documentation", "keyword.other.documentation"],
      "settings": { "foreground": "#67a37c", "fontStyle": "italic bold" }
    },

    // Keywords (declare, namespace, use, final readonly class, private, public function…)
    {
      "name": "Keyword",
      "scope": [
        "keyword", "keyword.control", "keyword.operator.new", "keyword.operator.expression",
        "keyword.operator.logical.php", "keyword.operator.type.php", "keyword.other",
        "storage", "storage.type", "storage.modifier", "storage.type.function", "storage.type.class",
        "storage.type.namespace", "storage.type.trait", "storage.type.interface", "storage.type.enum",
        "storage.type.modifier", "storage.modifier.readonly", "keyword.other.use.php", "keyword.other.namespace.php",
        "support.function.construct", "constant.language", "variable.language.this", "variable.language.self",
        "keyword.other.class.php"
      ],
      "settings": { "foreground": "#cf8e6d" }
    },
    {
      "name": "PHP open / close tag (<?php ?>)",
      "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php", "punctuation.section.embedded.begin.php source.php", "punctuation.section.embedded.end.php source.php"],
      "settings": { "foreground": "#cf8e6d", "fontStyle": "bold" }
    },

    // Literals
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.regexp", "punctuation.definition.string", "string.unquoted.heredoc", "string.unquoted.nowdoc"],
      "settings": { "foreground": "#6aab73" }
    },
    {
      "name": "Escape sequence",
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "settings": { "foreground": "#cf8e6d", "fontStyle": "bold" }
    },
    {
      "name": "String interpolation",
      "scope": ["punctuation.definition.variable.php string", "string variable.other.php", "meta.embedded.line punctuation.section.embedded"],
      "settings": { "foreground": "#c77dbb" }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#2aacb8" }
    },
    {
      "name": "Constant",
      "scope": ["constant.other", "support.constant", "constant.other.class.php", "constant.other.php"],
      "settings": { "foreground": "#c77dbb", "fontStyle": "italic" }
    },
    {
      "name": "true / false / null",
      "scope": ["constant.language.boolean", "constant.language.null", "constant.language.php"],
      "settings": { "foreground": "#cf8e6d" }
    },

    // Variables & properties ($paymentGateway, $this->orderService)
    {
      "name": "Variable / property",
      "scope": [
        "variable", "variable.other", "variable.other.php", "variable.other.property", "variable.other.object.property",
        "variable.parameter", "punctuation.definition.variable", "meta.object-literal.key", "support.variable"
      ],
      "settings": { "foreground": "#c77dbb" }
    },
    {
      "name": "Static property",
      "scope": ["variable.other.class.php"],
      "settings": { "foreground": "#c77dbb", "fontStyle": "italic" }
    },

    // Functions
    {
      "name": "Function / method",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "meta.method-call", "meta.function-call.php entity.name.function"],
      "settings": { "foreground": "#56a8f5" }
    },
    {
      "name": "Magic method (__construct)",
      "scope": ["entity.name.function.magic", "support.function.magic", "meta.method.php entity.name.function.magic"],
      "settings": { "foreground": "#56a8f5" }
    },
    {
      "name": "Static call",
      "scope": ["meta.method-call.static.php entity.name.function", "meta.function-call.static entity.name.function"],
      "settings": { "foreground": "#56a8f5", "fontStyle": "italic" }
    },

    // Types, classes, namespaces (App\Http\Controllers, OrderController, PaymentGatewayInterface)
    {
      "name": "Type / class / namespace",
      "scope": [
        "entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class",
        "support.class", "support.type", "support.other.namespace", "storage.type.php", "keyword.other.type.php",
        "entity.name.type.namespace.php", "support.other.namespace.php", "entity.other.alias.php"
      ],
      "settings": { "foreground": "#bcbec4" }
    },
    {
      "name": "Namespace separator",
      "scope": ["punctuation.separator.inheritance.php"],
      "settings": { "foreground": "#bcbec4" }
    },

    // Attributes / annotations / decorators
    {
      "name": "Attribute",
      "scope": ["meta.attribute", "meta.attribute.php", "meta.decorator", "punctuation.decorator", "storage.type.annotation", "punctuation.definition.attribute"],
      "settings": { "foreground": "#b3ae60" }
    },

    // Operators & punctuation
    {
      "name": "Operator / punctuation",
      "scope": ["keyword.operator", "punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#bcbec4" }
    },

    // Markup: HTML / Blade / JSON / Markdown
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#d5b778" }
    },
    {
      "name": "Attribute name",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.blade"],
      "settings": { "foreground": "#bababa" }
    },
    {
      "name": "Blade directive",
      "scope": ["keyword.blade", "keyword.control.blade", "punctuation.definition.keyword.blade", "support.function.construct.begin.blade", "support.function.construct.end.blade"],
      "settings": { "foreground": "#cf8e6d", "fontStyle": "bold" }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json", "support.type.property-name"],
      "settings": { "foreground": "#c77dbb" }
    },
    {
      "name": "CSS property",
      "scope": ["support.type.property-name.css", "support.type.vendored.property-name.css"],
      "settings": { "foreground": "#cf8e6d" }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section.markdown"],
      "settings": { "foreground": "#cf8e6d", "fontStyle": "bold" }
    },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code.block"],
      "settings": { "foreground": "#6aab73" }
    },
    {
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#548af7" }
    },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#6aab73" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#f75464" } },
    { "scope": ["markup.changed"], "settings": { "foreground": "#548af7" } },

    // Errors
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#f75464" }
    }
  ]
}
